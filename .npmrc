# pnpm behavior for the Narrative Forge monorepo
# See ADR-003 (Monorepo structure) and docs/engineering-baseline.md

# Dependency isolation (pnpm default; declared explicitly for clarity)
node-linker=isolated

# Automatically install missing peer dependencies
auto-install-peers=true

# Do not fail the install when optional peers are missing
strict-peer-dependencies=false

# Link workspace packages so cross-package imports resolve locally
link-workspace-packages=true

# Share the same lockfile/store across the workspace
prefer-workspace-packages=true

# Keep the store compact
save-workspace-protocol=workspace:*
